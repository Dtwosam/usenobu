{
  "name": "nobu",
  "version": "0.1.0",
  "private": true,
  "description": "Nobu — post-purchase price-monitoring platform (live: Target.com)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate:up": "tsx src/db/cli.ts up",
    "migrate:down": "tsx src/db/cli.ts down",
    "serpapi:live-audit": "tsx src/serpapi/run-live-audit.ts",
    "serpapi:repair-audit": "tsx src/serpapi/run-repair-audit.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "next": "^15.2.4",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}

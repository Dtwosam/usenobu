# AfterBuy environment variable names only.
# Copy to .env and set real values locally. Never commit secrets.

# --- Required when SerpApi integration is enabled (Lane 3+) ---
# Server-side only. Never expose to the browser bundle or client logs.
SERPAPI_API_KEY=

# --- Database (deployed / persistent environments) ---
DATABASE_URL=
# Local SQLite path for Lane 1 migration CLI / offline proof (no secrets)
AFTERBUY_DB_PATH=

# --- Application ---
# public base URL of the deployed HTTPS service (no trailing slash)
APP_BASE_URL=
# local or production node environment
NODE_ENV=development

# --- Optional: email alerts (not required for free A2MCP MVP) ---
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=

# --- Optional: session / auth secrets (if web auth is added later) ---
# SESSION_SECRET=

# --- Optional: scheduler / cron auth for internal jobs ---
# CRON_SECRET=

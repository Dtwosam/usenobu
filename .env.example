# Nobu environment variable names only.
# Copy to .env and set real values locally. Never commit secrets.

# --- Required when SerpApi integration is enabled (Lane 3+) ---
# Server-side only. Never expose to the browser bundle or client logs.
SERPAPI_API_KEY=

# --- Database (deployed / persistent environments) ---
DATABASE_URL=
# Durable policy-operations Postgres (Lane 8-R2A). Falls back to DATABASE_URL when unset.
# Required in production. Never use /tmp SQLite for policy ops.
# POLICY_OPS_DATABASE_URL=
# Local SQLite path for Lane 1 migration CLI / offline proof (no secrets)
NOBU_DB_PATH=
# Local policy-ops SQLite path (non-production only; never /tmp)
# NOBU_POLICY_OPS_DB_PATH=

# --- Application ---
# public base URL of the deployed HTTPS service (no trailing slash)
APP_BASE_URL=
# local or production node environment
NODE_ENV=development

# --- Optional: email alerts (not required for free A2MCP MVP) ---
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=

# --- Passwordless account auth (Lane 7.3A.2A.1) — server-only ---
# SESSION_SECRET=          # >=16 chars; signs/guards session lifecycle
# RESEND_API_KEY=          # or EMAIL_PROVIDER_API_KEY for Resend HTTP API
# EMAIL_FROM_ADDRESS=      # verified sender, e.g. Nobu <noreply@yourdomain>
# AUTH_EMAIL_FROM=         # optional alias for EMAIL_FROM_ADDRESS
# APP_BASE_URL=https://www.usenobu.xyz   # magic-link origin (canonical consumer site)
# AUTH_DATABASE_URL=       # optional; falls back to DATABASE_URL / POLICY_OPS_DATABASE_URL
# DATABASE_URL=            # Postgres durable auth + account purchase blobs (required on Vercel)
# NOBU_AUTH_TEST_MODE=1    # tests/e2e only — capture magic links, never use in prod
# Note: A2MCP agent URL stays https://usenobu.vercel.app/v1/agent (not the consumer www host)

# --- Policy operations auth (Lane 8-R2A) — server-only; never NEXT_PUBLIC_ ---
# CRON_SECRET=          # Bearer for POST /v1/owner/policy-scheduler
# OWNER_OPS_SECRET=     # Bearer for owner review + status (not interchangeable with CRON for writes)

# --- AI agent intake (Lane 7.5E.2) — server-only Groq ---
# Groq OpenAI-compatible API. Never expose to the browser.
# GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
# NOBU_AI_MODEL=openai/gpt-oss-20b
# Force deterministic extractor even when a key is present (tests/debug)
# NOBU_AI_FORCE_DETERMINISTIC=1
